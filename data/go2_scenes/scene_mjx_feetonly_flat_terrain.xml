<!--
  Go2 MJX scene, feet-only collisions, flat terrain.

  Mirrors mujoco_playground's Go1 scene_mjx_feetonly_flat_terrain.xml,
  but pulls in menagerie's unitree_go2 robot definition.

  What we DON'T re-declare (menagerie's go2_mjx.xml already provides):
    body-frame sensors (gyro, local_linvel, accelerometer, position,
    upvector, forwardvector, global_linvel, global_angvel, orientation)
    AND the "home" keyframe with the symmetric-hip standing pose.
  Re-declaring any of those raises an "XML Error: repeated name" at
  compile time. If menagerie's XML stops shipping one of them, the
  failure mode flips to a sensor-not-found at reset/step time, and we
  add the missing piece back here.

  What we DO add: per-foot framelinvel/framepos sensors (menagerie does
  not ship these; Go1's reward code expects them), the floor geom, and
  floor-contact sensors via sensor_feet.xml.

  Foot site names FL_foot/FR_foot/RL_foot/RR_foot match menagerie's
  go2_mjx.xml; foot geom names FL/FR/RL/RR also match.
-->
<mujoco model="go2_feetonly_flat_terrain">
  <include file="go2_mjx.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          condim="3" friction="0.6"/>
  </worldbody>

  <sensor>
    <framelinvel name="FR_global_linvel" objtype="site" objname="FR_foot"/>
    <framelinvel name="FL_global_linvel" objtype="site" objname="FL_foot"/>
    <framelinvel name="RR_global_linvel" objtype="site" objname="RR_foot"/>
    <framelinvel name="RL_global_linvel" objtype="site" objname="RL_foot"/>
    <framepos    name="FR_pos"           objtype="site" objname="FR_foot"/>
    <framepos    name="FL_pos"           objtype="site" objname="FL_foot"/>
    <framepos    name="RR_pos"           objtype="site" objname="RR_foot"/>
    <framepos    name="RL_pos"           objtype="site" objname="RL_foot"/>
  </sensor>

  <include file="sensor_feet.xml"/>
</mujoco>
