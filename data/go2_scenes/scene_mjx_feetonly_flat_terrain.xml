<!--
  Go2 MJX scene, feet-only collisions, flat terrain.

  Sensor inventory after observing what menagerie's go2_mjx.xml actually
  provides vs what Go1's task code expects:

    Provided by menagerie : accelerometer, gyro, global_linvel,
                            global_angvel, global_position, orientation.
    Missing in menagerie  : local_linvel, upvector, forwardvector,
                            position. We add these below.
    Per-foot, we add      : framelinvel and framepos on each foot site,
                            plus floor-contact sensors via sensor_feet.xml.

  Naming invariant: per-foot sensors must be named {foot_site_name}_{kind}
  because Go1 builds names at runtime as f"{site}_global_linvel".

  We do NOT re-declare anything menagerie already provides (which raises
  "XML Error: repeated name") and we do NOT re-declare the "home" keyframe.
-->
<mujoco model="go2_feetonly_flat_terrain">
  <include file="go2_mjx.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          condim="3" friction="0.6"/>
  </worldbody>

  <sensor>
    <velocimeter name="local_linvel"    site="imu"/>
    <framezaxis  name="upvector"        objtype="site" objname="imu"/>
    <framexaxis  name="forwardvector"   objtype="site" objname="imu"/>
    <framepos    name="position"        objtype="site" objname="imu"/>

    <framelinvel name="FR_foot_global_linvel" objtype="site" objname="FR_foot"/>
    <framelinvel name="FL_foot_global_linvel" objtype="site" objname="FL_foot"/>
    <framelinvel name="RR_foot_global_linvel" objtype="site" objname="RR_foot"/>
    <framelinvel name="RL_foot_global_linvel" objtype="site" objname="RL_foot"/>
    <framepos    name="FR_foot_pos"           objtype="site" objname="FR_foot"/>
    <framepos    name="FL_foot_pos"           objtype="site" objname="FL_foot"/>
    <framepos    name="RR_foot_pos"           objtype="site" objname="RR_foot"/>
    <framepos    name="RL_foot_pos"           objtype="site" objname="RL_foot"/>
  </sensor>

  <include file="sensor_feet.xml"/>
</mujoco>
