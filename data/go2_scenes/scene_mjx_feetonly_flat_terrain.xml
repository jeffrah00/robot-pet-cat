<!--
  Go2 MJX scene, feet-only collisions, flat terrain.

  Mirrors the structure of mujoco_playground's Go1
  scene_mjx_feetonly_flat_terrain.xml, but pulls in menagerie's
  unitree_go2 robot definition.

  Sensor strategy:
    menagerie's go2_mjx.xml ALREADY declares the standard body-frame
    sensors (gyro, local_linvel, accelerometer, etc.) anchored to the
    "imu" site. Re-declaring them here raises "repeated name". So this
    file only adds per-foot framelinvel/framepos (Go1's reward code
    expects them, menagerie does not ship them) and floor-contact
    sensors via sensor_feet.xml.

    If menagerie's go2_mjx.xml is missing one of the standard sensors
    Go1 expects (gyro, local_linvel, accelerometer, upvector,
    forwardvector, global_linvel, global_angvel, position, orientation),
    the symptom is a sensor-not-found error during reset or step, not
    at compile time, and we add the specific missing sensor back here.

  Foot site names FL_foot/FR_foot/RL_foot/RR_foot match menagerie's
  go2_mjx.xml; foot geom names FL/FR/RL/RR also match.

  Home keyframe uses Go2's symmetric-hip pose (0 0.9 -1.8 per leg) and
  base height 0.27 m.
-->
<mujoco model="go2_feetonly_flat_terrain">
  <include file="go2_mjx.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
          condim="3" friction="0.6"/>
  </worldbody>

  <sensor>
    <!-- Per-foot kinematics. menagerie provides body-frame sensors but
         not these. Site names match menagerie's foot sites. -->
    <framelinvel name="FR_global_linvel" objtype="site" objname="FR_foot"/>
    <framelinvel name="FL_global_linvel" objtype="site" objname="FL_foot"/>
    <framelinvel name="RR_global_linvel" objtype="site" objname="RR_foot"/>
    <framelinvel name="RL_global_linvel" objtype="site" objname="RL_foot"/>
    <framepos    name="FR_pos"           objtype="site" objname="FR_foot"/>
    <framepos    name="FL_pos"           objtype="site" objname="FL_foot"/>
    <framepos    name="RR_pos"           objtype="site" objname="RR_foot"/>
    <framepos    name="RL_pos"           objtype="site" objname="RL_foot"/>
  </sensor>

  <include file="sensor_feet.xml"/>

  <keyframe>
    <!-- 19 elements: 7 root (xyz + quat) + 12 joints (hip, thigh, calf
         per leg, in menagerie's joint declaration order). -->
    <key name="home"
         qpos="0 0 0.27 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"
         ctrl="0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"/>
  </keyframe>
</mujoco>
