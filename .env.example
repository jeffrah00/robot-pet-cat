# Copy this file to .env and fill in the values.
# .env is gitignored and will never be committed.

# Hugging Face — get token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USERNAME=jeffrah00

# Weights & Biases — get key at https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WANDB_ENTITY=jeffrah00
WANDB_PROJECT=robot-pet-cat

# RunPod — Settings -> API Keys (only if you script container spawn)
RUNPOD_API_KEY=

# Pexels — free API key at https://www.pexels.com/api/new/
# Used by scripts/fetch_clip.py to bypass Cloudflare on direct page fetches.
# 200 requests/hour, 20000/month free tier. Plenty.
PEXELS_API_KEY=
